{
    "name": "apajo/symfony-multi-tenancy-bundle",
    "type": "symfony-bundle",
    "description": "Symfony multi tenancy bundle",
    "minimum-stability": "stable",
    "keywords": [
        "Symfony",
        "Doctrine",
        "Tenants",
        "Multi-tenancy",
        "Dynamic tenant configuration",
        "Saas",
        "Software-as-a-Service",
        "Host based multi tenancy"
    ],
    "homepage": "https://www.apajo.ee",
    "license": "MIT",
    "authors": [
        {
            "name": "Andres Pajo",
            "homepage": "https://www.apajo.ee"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/annotations": "^2.0",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "knplabs/gaufrette": "^0.11.1",
        "symfony/config": "^6.4|^7.1",
        "symfony/dependency-injection": "^6.4|^7.1",
        "symfony/filesystem": "^6.4|^7.1",
        "symfony/mailer": "^6.4|^7.1",
        "symfony/orm-pack": "^2.4",
        "symfony/process": "^6.4|^7.1",
        "symfony/runtime": "^6.4|^7.1",
        "symfony/security-bundle": "^6.4|^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "symfony/dotenv": "^6.4|^7.0",
        "symfony/phpunit-bridge": "^6.4|^7.0",
        "symfony/yaml": "^7.2"
    },
    "scripts": {
        "cs-fixer": [
            "php-cs-fixer fix --verbose"
        ],
        "psalm": [
            "psalm"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test:unit": [
            "@php vendor/bin/phpunit --testsuite unit"
        ],
        "test:integration": [
            "@php vendor/bin/phpunit --testsuite integration"
        ],
        "test:db": [
            "@php vendor/bin/phpunit --testsuite database"
        ],
        "docker:up": [
            "docker compose up -d --wait database"
        ],
        "docker:down": [
            "docker compose down -v --remove-orphans"
        ],
        "docker:test": [
            "docker compose run --rm tests vendor/bin/phpunit; status=$?; docker compose down -v --remove-orphans; exit $status"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "aPajo\\MultiTenancyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "aPajo\\MultiTenancyBundle\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
