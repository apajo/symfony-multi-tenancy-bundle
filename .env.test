# Test-only overrides. Anything not set here falls through to .env, which the
# PHPUnit bootstrap loads as the lowest-priority layer — so the database
# credentials live in .env alone and editing them there is felt by every run,
# in the container and on the host alike.
#
# Precedence, highest first:
#   1. real environment variables
#   2. .env.test.local  (gitignored, for local overrides)
#   3. .env.test        (this file)
#   4. .env
#
# The `database` suite needs a real MySQL server (there is no pdo_sqlite on this
# platform). The repo ships one: `make test` starts the container defined in
# compose.yaml, runs the suite and stops it again. The suite uses dedicated
# `mtb_*_test` schemas and creates them itself, so it never touches application
# data. If the server is unreachable the database suite fails rather than
# skipping, so a green run always means the connection switching was actually
# exercised. The unit and integration suites do not need a server.

APP_ENV=test
