# Defaults for the bundle's own dev tooling (bin/console) and test suite.
# This bundle is a library: these values exist only so the in-repo TestKernel
# can boot. A consuming application supplies its own.
#
# APP_ENV=test selects .env.test, which is loaded on top of this file.

APP_ENV=test
APP_DEBUG=1
APP_SECRET=test-secret-not-used-outside-tests

MAILER_DSN=null://null

# Points at the MySQL container from compose.yaml. From the host it is
# published on 127.0.0.1:49173 to avoid colliding with local application
# databases; inside the runner container compose sets DATABASE_HOST=database
# and DATABASE_PORT=3306.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=49173
DEFAULT_DATABASE_URL=mysql://mtb:mtb@${DATABASE_HOST}:${DATABASE_PORT}/mtb_default_test
TENANT_DATABASE_URL=mysql://mtb:mtb@${DATABASE_HOST}:${DATABASE_PORT}/mtb_tenant_test
